# Copy to `.env.local` for local development. `.env*` is git-ignored — never
# commit real keys. On Vercel, set these under Project → Settings →
# Environment Variables.

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# Optional public site URL for metadataBase / Open Graph
# Example production value: https://www.example.com
# If unset, the app falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Lead delivery — POST /api/leads (the /contact form) and
# POST /api/distributor-leads (the short QR form at /apply)
# ---------------------------------------------------------------------------
#
# All three of RESEND_API_KEY, LEAD_FROM_EMAIL and LEAD_TO_EMAIL must be set
# for email to be sent. If any is missing, the endpoint responds 503 with
# `configured: false` and the form tells the visitor plainly that delivery is
# not connected and nothing was sent or stored. That is the intended state
# until official contact details are confirmed by the client (C-017).
#
# These are server-only. Do NOT prefix them with NEXT_PUBLIC_ — that would
# inline the API key into the browser bundle.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Its domain must be verified in Resend or delivery will fail.
# A display name is allowed, e.g. Zinc'd Website <website@example.com>
LEAD_FROM_EMAIL=

# Where enquiries are delivered.
LEAD_TO_EMAIL=

# Optional. Routes distributor/partner enquiries to a separate inbox.
# Falls back to LEAD_TO_EMAIL when unset.
LEAD_PARTNER_TO_EMAIL=

# ---------------------------------------------------------------------------
# Direct purchase (the commercial path on /product)
# ---------------------------------------------------------------------------
#
# Stripe Payment Link or Checkout Session URL for the complete $5,000 system.
# Example: https://buy.stripe.com/xxxxx
#
# When set, /product shows a "Buy now" button that opens this URL.
# When unset, Buy now is replaced with a pool-assessment enquiry — the page
# never renders a dead or placeholder payment link.
#
# This IS public (the browser navigates to it), hence NEXT_PUBLIC_.
# It is inlined at build time — set it in `.env.local` and in Vercel Project
# Environment Variables before deploying.
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=
